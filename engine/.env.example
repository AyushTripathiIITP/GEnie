# Copy to .env and fill in. .env is gitignored — never commit your key.

# --- Option A: direct Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: a LiteLLM proxy (Anthropic-compatible). If set, these win over ANTHROPIC_API_KEY.
#     The engine strips a trailing /v1 automatically (the SDK appends /v1/messages).
#     Computer use is verified to pass through LiteLLM. Set the model the proxy serves. ---
# LITELLM_BASE_URL=https://litellm.windflow.ai/v1
# LITELLM_API_KEY=sk-...
# JOBAGENT_MODEL=claude-opus-4-7

# Optional overrides (defaults shown):
# JOBAGENT_MODEL=claude-opus-4-8     # computer-use models only (NOT claude-fable-5)
# JOBAGENT_MODE=step                 # step = confirm each action; auto = unattended
# JOBAGENT_MAX_STEPS=40
# JOBAGENT_LONG_EDGE=1366            # image long edge sent to Claude (up to 2576 on Opus 4.8)
# JOBAGENT_EFFORT=medium             # low|medium|high
