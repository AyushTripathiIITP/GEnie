# Secrets — NEVER commit
.env
.env.*
# keep the template (no secrets) — note: gitignore has no inline comments, so this is its own line
!.env.example
*.key
secrets.*

# Engine runtime artifacts (may contain PII from screenshots of LinkedIn)
runs/
screenshots/
*.png
*.jpg
*.jpeg
!docs/**/*.png        # allow doc images if any

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
